FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    openssh-server python3 procps iproute2 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1001 -s /bin/bash lab \
    && mkdir -p /run/sshd /home/lab/.ssh && chmod 700 /home/lab/.ssh \
    && rm -f /etc/ssh/ssh_host_* \
    && printf '\nPasswordAuthentication yes\nPermitRootLogin no\nUsePAM no\nPrintMotd no\nLogLevel VERBOSE\n' >> /etc/ssh/sshd_config
COPY remote_job.py observe.py server_entry.py /opt/
CMD ["python3", "/opt/server_entry.py"]
