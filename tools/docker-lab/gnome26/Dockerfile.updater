# Build the pinned GNOME desktop first using the original compose.yaml.
FROM termia-lab-430-gnome26:local AS desktop
COPY fixtures/ /opt/fixtures/
RUN echo 'b0b1382abb505ab09f004a6b555f39b8b142c95a7d4dbe01052784f1151b0691  /opt/fixtures/beta3.deb' | sha256sum -c - \
    && echo 'a8f1582fd70eb12510b29522fe164b23e38c0f69850e63a0908de6844fa995b3  /opt/fixtures/termia_0.6.0.beta.4-1_all.deb' | sha256sum -c - \
    && apt-get -o APT::Update::Error-Mode=any update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --no-remove \
       git ptyxis /opt/fixtures/beta3.deb \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY review/ /opt/review/
COPY panel.py launch.py reset.py updater-init.sh configure-desktop.py UPDATER_COMMIT /opt/upgrade-lab/
COPY org.termia.TestingLab.desktop /usr/share/applications/
COPY termia-lab-updater.service /etc/systemd/system/
RUN mkdir -p /etc/systemd/system/termia-lab.target.wants \
    && ln -s /etc/systemd/system/termia-lab-updater.service /etc/systemd/system/termia-lab.target.wants/
