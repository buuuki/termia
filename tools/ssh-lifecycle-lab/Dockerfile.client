FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gdb python3 python3-gi python3-yaml python3-cryptography python3-paramiko gir1.2-gtk-4.0 gir1.2-vte-3.91 gir1.2-gtksource-5 openssh-client sshpass xvfb xauth dbus-daemon xdotool fonts-dejavu-core ca-certificates && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1001 -s /bin/bash tester
WORKDIR /work
USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends valgrind && rm -rf /var/lib/apt/lists/*
COPY --chown=tester:tester src /work/src
COPY --chown=tester:tester run_termia.py /work/run_termia.py
COPY --chown=tester:tester tests /work/tests
COPY --chown=tester:tester scripts /work/scripts
COPY --chown=tester:tester lab /work/tools/ssh-lifecycle-lab
USER tester
ENV TERMIA_LAB_HOST=termia-ssh-lifecycle-lab TERMIA_LAB_PORT=22 TERMIA_LAB_STATUS=/observations/status.json
CMD ["python3", "tools/ssh-lifecycle-lab/run_probe.py"]
